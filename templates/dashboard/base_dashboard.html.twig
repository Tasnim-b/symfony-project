<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}HealFit Dashboard{% endblock %}</title>

    <!-- CSS -->
    <link rel="stylesheet" href="{{ asset('assets/styles/dashboard.css') }}">
    {% block stylesheets %}{% endblock %}

    <!-- Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Chart.js pour les graphiques -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    <div class="dashboard-container">
        <!-- Navbar -->
        <nav class="dashboard-navbar">
            <div class="navbar-left">
                <a href="{{ path('app_home') }}" class="dashboard-logo">
                    <img src="{{ asset('assets/images/healFit-logo.png') }}" alt="HealFit Logo" class="logo-img" onerror="this.style.display='none'">
                    <span class="logo-text">
                        <span class="logo-part1">HEAL</span>
                        <span class="logo-part2">FIT</span>
                    </span>
                </a>
            </div>

            <div class="navbar-center">
                <h1 class="dashboard-title">{% block page_title %}Tableau de Bord{% endblock %}</h1>
            </div>

            <div class="navbar-right">
                <!-- Notification -->
                {% set notifCount = 0 %} {# getAllNotificationsCount(app.user) needs Twig extension or global var #}
                <div class="notification-icon">
                    <a href="{{ path('app_notifications') }}">
                    <i class="fas fa-bell"></i>
                    <span class="notification-badge" id="notificationBadge" style="display: none;">0</span>
                    </a>
                </div>

                <!-- Messagerie -->
                {% set unreadMessages = 0 %} {# getUnreadMessagesCount(app.user) needs Twig extension #}
                <div class="messaging-icon">
                    <a href="{{ path('app_messagerie') }}">
                        <i class="fas fa-envelope"></i>
                        <span class="message-badge" id="globalUnreadCount" style="display: none;">0</span>
                    </a>
                </div>

                <!-- Profil Utilisateur -->
                <div class="user-profile-dropdown">
                    <div class="user-avatar" id="userMenuTrigger">
                        {% if app.user and app.user.profileImage %}
                            <img src="{{ asset('uploads/profile_images/' ~ app.user.profileImage) }}" 
                                alt="Photo de profil" 
                                class="profile-img"
                                onerror="this.src='{{ asset('assets/images/default-avatar.jpg') }}'">
                        {% else %}
                            <img src="{{ asset('assets/images/default-avatar.jpg') }}" 
                                alt="Photo de profil" 
                                class="profile-img">
                        {% endif %}
                        <span>{{ app.user ? app.user.fullName : 'Invité' }}</span>
                        <i class="fas fa-chevron-down"></i>
                    </div>

                    <div class="dropdown-menu" id="userMenu">
                        <div class="user-info">
                            {% if app.user and app.user.profileImage %}
                                <img src="{{ asset('uploads/profile_images/' ~ app.user.profileImage) }}" 
                                    alt="Photo de profil" 
                                    class="menu-profile-img"
                                    onerror="this.src='{{ asset('assets/images/default-avatar.jpg') }}'">
                            {% else %}
                                <img src="{{ asset('assets/images/default-avatar.jpg') }}" 
                                    alt="Photo de profil" 
                                    class="menu-profile-img">
                            {% endif %}
                            <div class="user-details">
                                <h4>{{ app.user ? app.user.fullName : 'Invité' }}</h4>
                                <p>{{ app.user ? app.user.email : '' }}</p>
                            </div>
                        </div>

                        <div class="dropdown-divider"></div>

                        <a href="{{ path('app_profil') }}" class="dropdown-item">
                            <i class="fas fa-user-circle"></i>
                            <span>Mon Profil</span>
                        </a>

                        <a href="{{ path('app_dashboard') }}" class="dropdown-item">
                            <i class="fas fa-tachometer-alt"></i>
                            <span>Tableau de bord</span>
                        </a>

                        <div class="dropdown-divider"></div>

                        {% if app.user %}
                            <form action="{{ path('app_logout') }}" method="POST" class="logout-form">
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                                <button type="submit" class="dropdown-item logout">
                                    <i class="fas fa-sign-out-alt"></i>
                                    <span>Déconnexion</span>
                                </button>
                            </form>
                        {% else %}
                             <a href="{{ path('app_login') }}" class="dropdown-item">
                                <i class="fas fa-sign-in-alt"></i>
                                <span>Connexion</span>
                            </a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </nav>

        <!-- Sidebar -->
        <aside class="dashboard-sidebar">
            <div class="sidebar-header">
                <h3><i class="fas fa-bars"></i> Menu</h3>
                <button class="sidebar-toggle" id="sidebarToggle">
                    <i class="fas fa-chevron-left"></i>
                </button>
            </div>

            <nav class="sidebar-menu">
                <a href="{{ path('app_dashboard') }}" class="menu-item {% if app.request.get('_route') == 'app_dashboard' %}active{% endif %}">
                    <i class="fas fa-tachometer-alt"></i>
                    <span>Tableau de bord</span>
                </a>

                <div class="menu-section">
                    <h4>Santé & Fitness</h4>

                    <a href="{{ path('diet_plan') }}" class="menu-item {% if app.request.get('_route') in ['diet_plan', 'diet_results'] %}active{% endif %}">
                        <i class="fas fa-utensils"></i>
                        <span>Régime alimentaire</span>
                        <span class="badge">Nouveau</span>
                    </a>

                    <a href="{{ path('app_workout_personalized') }}" class="menu-item {% if app.request.get('_route') in ['app_workout_personalized', 'app_workout_show'] %}active{% endif %}">
                        <i class="fas fa-dumbbell"></i>
                        <span>Workout personnalisé</span>
                    </a>

                    <a href="#" class="menu-item">
                        <i class="fas fa-calendar-alt"></i>
                        <span>Planning d'entraînement</span>
                    </a>

                    <a href="#" class="menu-item">
                        <i class="fas fa-map-marker-alt"></i>
                        <span>Salle de sport proche</span>
                    </a>
                </div>

                <div class="menu-section">
                    <h4>Expertise</h4>

                    <a href="{{ path('app_nutritionniste') }}" class="menu-item {% if app.request.get('_route') == 'app_nutritionniste' %}active{% endif %}">
                        <i class="fas fa-user-md"></i>
                        <span>Nutritionniste expert</span>
                    </a>

                    <a href="{{ path('app_communaute') }}" class="menu-item {% if app.request.get('_route') == 'app_communaute' %}active{% endif %}">
                        <i class="fas fa-users"></i>
                        <span>Communauté</span>
                        {# <span class="badge">{{ getTotalUsers() }}</span> #}
                    </a>

                    <a href="#" class="menu-item">
                        <i class="fas fa-building"></i>
                        <span>Partenaires fitness</span>
                    </a>
                </div>

                <div class="menu-section">
                    <h4>Progression</h4>

                    <a href="#" class="menu-item">
                        <i class="fas fa-chart-line"></i>
                        <span>Mes progrès</span>
                    </a>

                    <a href="#" class="menu-item">
                        <i class="fas fa-trophy"></i>
                        <span>Mes objectifs</span>
                    </a>
                </div>

                <div class="menu-section">
                    <h4>Ressources</h4>

                    <a href="{{ path('app_guide_sante') }}" class="menu-item {% if app.request.get('_route') in ['app_guide_sante', 'app_article_new', 'app_article_show'] %}active{% endif %}">
                        <i class="fas fa-book"></i>
                        <span>Guide santé</span>
                    </a>

                    <a href="{{ path('app_videos_exercices') }}" class="menu-item {% if app.request.get('_route') == 'app_videos_exercices' %}active{% endif %}">
                        <i class="fas fa-video"></i>
                        <span>Vidéos d'exercices</span>
                    </a>
                </div>
            </nav>

            <div class="sidebar-footer">
                <div class="user-progress">
                    <div class="progress-info">
                        <span>Progression mensuelle</span>
                        <span>65%</span>
                    </div>
                    <div class="progress-bar">
                        <div class="progress-fill" style="width: 65%"></div>
                    </div>
                </div>

                <a href="#" class="premium-btn" style="text-decoration: none; text-align: center;">
                    <i class="fas fa-crown"></i>
                    Passer à Premium
                </a>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="dashboard-content">
            {% block content %}{% endblock %}
        </main>
        
        <!-- Chatbot Widget can stay here or be block -->
         {% block chatbot %}
        <div class="chatbot-widget" id="chatbotWidget">
            <div class="chatbot-header">
                <div class="chatbot-title">
                    <i class="fas fa-robot"></i>
                    <span>Assistant HealFit</span>
                </div>
                <button class="chatbot-close" id="closeChatbot">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="chatbot-messages" id="chatbotMessages">
                <div class="message bot">
                    <div class="message-content">
                        Bonjour ! Je suis votre assistant HealFit. Comment puis-je vous aider aujourd'hui ?
                    </div>
                </div>
            </div>
            <div class="chatbot-input">
                <input type="text" id="chatbotInput" placeholder="Posez-moi une question...">
                <button id="sendMessage"><i class="fas fa-paper-plane"></i></button>
            </div>
        </div>
        <button class="chatbot-toggle" id="openChatbot"><i class="fas fa-robot"></i></button>
        {% endblock %}
    </div>

    <!-- JavaScript -->
    <script src="{{ asset('js/dashboard.js') }}"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>
