{% extends 'dashboard/base_dashboard.html.twig' %}

{% block title %}HealFit Dashboard{% endblock %}

{% block content %}
    <!-- Cartes de bienvenue et stats rapides -->
    <div class="welcome-section">
        <div class="welcome-card">
            <h2>Bonjour, <span class="user-name">{{ user.fullName }}</span> 👋</h2>
            <p>Vous avez complété {{ dashboard.quick_stats.workouts_this_week }} entraînements cette semaine. Continuez comme ça !</p>
            <div class="welcome-stats">
                <div class="stat">
                    <i class="fas fa-fire"></i>
                    <div>
                        <h4>{{ dashboard.quick_stats.calories_burned|number_format(0, ',', ' ') }}</h4>
                        <span>Calories brûlées</span>
                    </div>
                </div>
                <div class="stat">
                    <i class="fas fa-running"></i>
                    <div>
                        <h4>{{ dashboard.quick_stats.distance }}km</h4>
                        <span>Distance parcourue</span>
                    </div>
                </div>
                <div class="stat">
                    <i class="fas fa-heartbeat"></i>
                    <div>
                        <h4>{{ dashboard.quick_stats.avg_bpm }}</h4>
                        <span>BPM moyenne</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="date-card">
            <h3><i class="fas fa-calendar-day"></i> Aujourd'hui</h3>
            <div class="current-date">
                <div class="date-day">{{ "now"|date("d") }}</div>
                <div class="date-month">{{ "now"|date("F Y") }}</div>
            </div>
            <div class="next-workout">
                {% set nextWorkout = dashboard.workouts|filter(w => w.status == 'pending')|first %}
                {% if nextWorkout %}
                    <p>Prochain entraînement: <strong>{{ nextWorkout.name }} ({{ nextWorkout.time }})</strong></p>
                    <button class="btn-start">Commencer</button>
                {% else %}
                    <p>Aucun entraînement prévu aujourd'hui</p>
                    <button class="btn-start">Planifier</button>
                {% endif %}
            </div>
        </div>
    </div>

    <!-- Graphiques et statistiques -->
    <div class="charts-section">
        <div class="chart-card">
            <div class="chart-header">
                <h3>Progression hebdomadaire</h3>
                <select class="chart-select">
                    <option>Cette semaine</option>
                    <option>Ce mois</option>
                    <option>Cette année</option>
                </select>
            </div>
            <div class="chart-container">
                <canvas id="progressChart" 
                        data-labels="{{ dashboard.weekly_progress.labels|json_encode }}" 
                        data-calories="{{ dashboard.weekly_progress.calories|json_encode }}"
                        data-distance="{{ dashboard.weekly_progress.distance|json_encode }}">
                </canvas>
            </div>
        </div>

        <div class="chart-card">
            <div class="chart-header">
                <h3>Répartition des calories</h3>
                <div class="chart-legend">
                    <span class="legend-item"><i class="fas fa-circle" style="color: #4CAF50;"></i> Protéines ({{ dashboard.nutrition.proteins }}%)</span>
                    <span class="legend-item"><i class="fas fa-circle" style="color: #2196F3;"></i> Glucides ({{ dashboard.nutrition.carbs }}%)</span>
                    <span class="legend-item"><i class="fas fa-circle" style="color: #FF9800;"></i> Lipides ({{ dashboard.nutrition.fats }}%)</span>
                </div>
            </div>
            <div class="chart-container">
                <canvas id="caloriesChart" 
                        data-proteins="{{ dashboard.nutrition.proteins }}"
                        data-carbs="{{ dashboard.nutrition.carbs }}"
                        data-fats="{{ dashboard.nutrition.fats }}">
                </canvas>
            </div>
        </div>
    </div>

    <!-- Entraînements et régime -->
    <div class="workout-diet-section">
        <div class="workout-plan">
            <div class="section-header">
                <h3><i class="fas fa-dumbbell"></i> Entraînement du jour</h3>
                <a href="#" class="view-all">Voir le planning complet <i class="fas fa-arrow-right"></i></a>
            </div>

            <div class="workout-list">
                {% for workout in dashboard.workouts %}
                    <div class="workout-item">
                        <div class="workout-icon">
                            {% if workout.name == 'Cardio Training' %}
                                <i class="fas fa-running"></i>
                            {% elseif workout.name == 'Musculation' %}
                                <i class="fas fa-dumbbell"></i>
                            {% elseif workout.name == 'Natation' %}
                                <i class="fas fa-water"></i>
                            {% else %}
                                <i class="fas fa-dumbbell"></i>
                            {% endif %}
                        </div>
                        <div class="workout-details">
                            <h4>{{ workout.name }}</h4>
                            <p>{{ workout.duration }} min • 
                            {% if workout.calories is defined %}
                                Brûle {{ workout.calories }} calories
                            {% elseif workout.type is defined %}
                                {{ workout.type }}
                            {% endif %}
                            </p>
                        </div>
                        <div class="workout-status {{ workout.status }}">
                            {% if workout.status == 'completed' %}
                                <i class="fas fa-check"></i>
                                Terminé
                            {% elseif workout.status == 'pending' %}
                                <i class="fas fa-clock"></i>
                                {{ workout.time }}
                            {% elseif workout.status == 'upcoming' %}
                                <i class="fas fa-calendar"></i>
                                {{ workout.time }}
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>

        <div class="diet-plan">
            <div class="section-header">
                <h3><i class="fas fa-utensils"></i> Repas recommandés</h3>
                <a href="#" class="view-all">Voir le menu complet <i class="fas fa-arrow-right"></i></a>
            </div>

            <div class="meal-list">
                {% for meal in dashboard.meals %}
                    <div class="meal-item">
                        <div class="meal-time">{{ meal.time }}</div>
                        <div class="meal-details">
                            <h4>{{ meal.name }}</h4>
                            <p>{{ meal.calories }} kcal • {{ meal.proteins }}g protéines</p>
                        </div>
                        <div class="meal-check">
                            {% if meal.completed %}
                                <i class="fas fa-check-circle" style="color: #2e7d32;"></i>
                            {% else %}
                                <i class="far fa-circle"></i>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>

    <!-- Salle de sport et communauté -->
    <div class="gym-community-section">
        <div class="gym-card">
            <div class="section-header">
                <h3><i class="fas fa-map-marker-alt"></i> Salles de sport proches</h3>
                <button class="btn-refresh"><i class="fas fa-sync-alt"></i></button>
            </div>

            <div class="gym-list">
                <div class="gym-item">
                    <div class="gym-info">
                        <h4>Fitness First</h4>
                        <p><i class="fas fa-map-marker"></i> 1.2 km • Ouvert 24h/24</p>
                        <div class="gym-rating">
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star-half-alt"></i>
                            <span>4.5 (128 avis)</span>
                        </div>
                    </div>
                    <button class="btn-direction">
                        <i class="fas fa-directions"></i> Itinéraire
                    </button>
                </div>

                <div class="gym-item">
                    <div class="gym-info">
                        <h4>Urban Fit Club</h4>
                        <p><i class="fas fa-map-marker"></i> 2.5 km • Piscine incluse</p>
                        <div class="gym-rating">
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="far fa-star"></i>
                            <span>4.0 (89 avis)</span>
                        </div>
                    </div>
                    <button class="btn-direction">
                        <i class="fas fa-directions"></i> Itinéraire
                    </button>
                </div>
            </div>
        </div>

        <div class="community-card">
            <div class="section-header">
                <h3><i class="fas fa-users"></i> Communauté active</h3>
                <a href="{{path('app_communaute')}}" class="view-all">Voir tous <i class="fas fa-arrow-right"></i></a>
            </div>

            <div class="community-members">
                {% set activeUsers = getActiveCommunityUsers(app.user, 5) %}
                {% if activeUsers is empty %}
                    <div class="no-active-members">Aucun membre actif pour le moment.</div>
                {% else %}
                    {% for member in activeUsers %}
                        <div class="member">
                            <img src="{{ member.profileImage ? asset('uploads/profile_images/' ~ member.profileImage) : 'https://randomuser.me/api/portraits/lego/1.jpg' }}" alt="Membre">
                            <div class="member-info">
                                <h5>{{ member.fullName }}</h5>
                                <p>Dernière activité : {{ member.lastActivity ? member.lastActivity|date('H:i') : '' }}</p>
                            </div>
                            <button class="btn-follow">Suivre</button>
                        </div>
                    {% endfor %}
                {% endif %}
            </div>

            <div class="community-challenge">
                <h4>Défi du mois: 100km en course</h4>
                <div class="challenge-progress">
                    <div class="progress-info">
                        <span>Votre progression: 42km</span>
                        <span>42%</span>
                    </div>
                    <div class="progress-bar">
                        <div class="progress-fill" style="width: 42%"></div>
                    </div>
                </div>
                <button class="btn-challenge">Participer</button>
            </div>
        </div>
    </div>
{% endblock %}
