{% extends 'dashboard/base_dashboard.html.twig' %}

{% block title %}Nouvel Article - HEALFIT{% endblock %}

{% block page_title %}Nouvel Article{% endblock %}

{% block stylesheets %}
<style>
    /* Styles spécifiques au formulaire qui n'existent pas dans dashboard.css */
    .form-card {
        background-color: white;
        padding: 30px;
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        margin-bottom: 25px;
    }

    .form-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        padding-bottom: 20px;
        border-bottom: 1px solid var(--light-gray);
    }

    .form-header h3 {
        color: var(--primary-dark);
        font-size: 1.3rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .article-form {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    @media (max-width: 768px) {
        .form-row {
            grid-template-columns: 1fr;
        }
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    .form-label {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 8px;
        color: var(--dark);
        font-weight: 600;
        font-size: 0.95rem;
    }

    .form-label i {
        color: var(--primary);
        width: 16px;
        text-align: center;
    }

    .form-input, .form-textarea, .form-select {
        padding: 12px 15px;
        border: 1px solid #ddd;
        border-radius: var(--radius-sm);
        font-size: 1rem;
        background-color: white;
        transition: var(--transition);
        width: 100%;
        font-family: inherit;
    }

    .form-input:focus, .form-textarea:focus, .form-select:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(46, 125, 50, 0.1);
    }

    .form-textarea {
        min-height: 100px;
        resize: vertical;
    }

    .form-help {
        margin-top: 5px;
        font-size: 0.85rem;
        color: var(--gray);
    }

    .form-select {
        appearance: none;
        background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right 15px center;
        background-size: 16px;
        padding-right: 40px;
    }

    /* Boutons d'action */
    .form-actions {
        display: flex;
        gap: 15px;
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px solid var(--light-gray);
    }

    .btn-publish {
        background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        color: white;
        border: none;
        padding: 12px 30px;
        border-radius: var(--radius-sm);
        font-weight: 600;
        cursor: pointer;
        transition: var(--transition);
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 1rem;
    }

    .btn-publish:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(46, 125, 50, 0.3);
    }

    .btn-cancel {
        background-color: var(--light-gray);
        color: var(--dark);
        border: none;
        padding: 12px 30px;
        border-radius: var(--radius-sm);
        font-weight: 600;
        cursor: pointer;
        transition: var(--transition);
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        font-size: 1rem;
    }

    .btn-cancel:hover {
        background-color: #e0e0e0;
    }

    @media (max-width: 576px) {
        .form-actions {
            flex-direction: column;
        }

        .btn-publish, .btn-cancel {
            justify-content: center;
        }
    }
</style>
{% endblock %}

{% block content %}
    <!-- Section de bienvenue -->
    <div class="welcome-section">
        <div class="welcome-card">
            <h2>Publier un nouvel article</h2>
            <p>Partagez vos connaissances en santé et bien-être avec la communauté HEALFIT</p>
        </div>

        <div class="date-card">
            <h3><i class="fas fa-calendar-alt"></i> Aujourd'hui</h3>
            <div class="current-date">
                <div class="date-day">{{ "now"|date('d') }}</div>
                <div class="date-month">{{ "now"|date('F Y') }}</div>
            </div>
            <div class="next-workout">
                <div>
                    <h4>Retour aux articles</h4>
                    <p>Voir toutes les publications</p>
                </div>
                <a href="{{ path('app_guide_sante') }}" class="btn-start">
                    <i class="fas fa-arrow-left"></i> Retour
                </a>
            </div>
        </div>
    </div>

    <!-- Formulaire de publication -->
    <div class="form-card">
        <div class="form-header">
            <h3><i class="fas fa-edit"></i> Rédiger votre article</h3>
        </div>

        <form method="post" action="{{ path('app_article_new') }}" class="article-form">
            <!-- CSRF Token -->
            <input type="hidden" name="_token" value="{{ csrf_token('article_new') }}">

            <!-- Première ligne : Titre et Catégorie -->
            <div class="form-row">
                <div class="form-group">
                    <label for="title" class="form-label">
                        <i class="fas fa-heading"></i> Titre de l'article
                    </label>
                    <input type="text" id="title" name="title" required
                            placeholder="Ex: Les bienfaits de la méditation quotidienne"
                            class="form-input">
                    <div class="form-help">Titre accrocheur qui résume votre article</div>
                </div>

                <div class="form-group">
                    <label for="category" class="form-label">
                        <i class="fas fa-tag"></i> Catégorie
                    </label>
                    <select id="category" name="category" required class="form-select">
                        <option value="">Sélectionnez une catégorie</option>
                        <option value="Nutrition">🍎 Nutrition</option>
                        <option value="Exercice">🏃‍♂️ Exercice</option>
                        <option value="Sommeil">😴 Sommeil</option>
                        <option value="Mental">🧠 Santé Mentale</option>
                        <option value="Hydratation">💧 Hydratation</option>
                        <option value="Prévention">🩺 Prévention</option>
                        <option value="Conseils">💡 Conseils Pratiques</option>
                    </select>
                </div>
            </div>

            <!-- Auteur -->
            <div class="form-group">
                <label for="author" class="form-label">
                    <i class="fas fa-user"></i> Auteur
                </label>
                <input type="text" id="author" name="author" required
                        value="{{ app.user ? app.user.fullName : '' }}"
                        placeholder="Votre nom ou pseudo"
                        class="form-input"
                        {{ app.user ? 'readonly' : '' }}>
            </div>

            <!-- Résumé -->
            <div class="form-group">
                <label for="excerpt" class="form-label">
                    <i class="fas fa-align-left"></i> Résumé
                </label>
                <textarea id="excerpt" name="excerpt" required
                            placeholder="Un court résumé qui apparaîtra dans la liste des articles (maximum 200 caractères)..."
                            class="form-textarea" rows="3" maxlength="200"></textarea>
                <div class="form-help">Court et accrocheur. Restez sous 200 caractères.</div>
            </div>

            <!-- Contenu ou URL -->
            <div class="form-group">
                <label for="content" class="form-label">
                    <i class="fas fa-link"></i> URL de l'article complet OU Contenu
                </label>
                <textarea id="content" name="content" required
                            placeholder="https://www.exemple.com/article-complet

OU écrivez directement votre contenu ici..."
                            class="form-textarea" rows="10"></textarea>
                <div class="form-help">
                    <strong>Option 1 :</strong> Entrez une URL (commençant par http:// ou https://) pour rediriger vers un article externe<br>
                    <strong>Option 2 :</strong> Écrivez directement votre contenu si vous créez un article interne
                </div>
            </div>

            <!-- Deuxième ligne : Temps de lecture et Image -->
            <div class="form-row">
                <div class="form-group">
                    <label for="read_time" class="form-label">
                        <i class="fas fa-clock"></i> Temps de lecture estimé
                    </label>
                    <input type="text" id="read_time" name="read_time" required
                            placeholder="Ex: 5 min"
                            class="form-input">
                </div>

                <div class="form-group">
                    <label for="image" class="form-label">
                        <i class="fas fa-image"></i> URL de l'image
                    </label>
                    <input type="url" id="image" name="image"
                            placeholder="https://images.unsplash.com/photo-..."
                            class="form-input">
                    <div class="form-help">Laissez vide pour utiliser une image par défaut selon la catégorie</div>
                </div>
            </div>

            <!-- Boutons d'action -->
            <div class="form-actions">
                <button type="submit" class="btn-publish">
                    <i class="fas fa-paper-plane"></i> Publier l'article
                </button>
                <a href="{{ path('app_guide_sante') }}" class="btn-cancel">
                    <i class="fas fa-times"></i> Annuler
                </a>
            </div>
        </form>
    </div>
{% endblock %}

{% block javascripts %}
<script>
    // Compteur de caractères pour le résumé
    const excerptTextarea = document.getElementById('excerpt');
    const excerptHelp = excerptTextarea.nextElementSibling;

    excerptTextarea.addEventListener('input', function() {
        const charCount = this.value.length;
        const maxChars = 200;

        if (charCount > maxChars) {
            this.value = this.value.substring(0, maxChars);
            excerptHelp.textContent = `Maximum ${maxChars} caractères atteint!`;
            excerptHelp.style.color = '#f44336';
        } else {
            excerptHelp.textContent = `${charCount}/${maxChars} caractères. Court et accrocheur.`;
            excerptHelp.style.color = 'var(--gray)';
        }
    });

    // Validation du formulaire
    const form = document.querySelector('.article-form');
    form.addEventListener('submit', function(e) {
        const title = document.getElementById('title').value.trim();
        const excerpt = document.getElementById('excerpt').value.trim();
        const content = document.getElementById('content').value.trim();
        const category = document.getElementById('category').value;
        const author = document.getElementById('author').value.trim();
        const readTime = document.getElementById('read_time').value.trim();

        if (!title || !excerpt || !content || !category || !author || !readTime) {
            e.preventDefault();
            alert('Veuillez remplir tous les champs obligatoires (*)');
            return false;
        }

        if (excerpt.length > 200) {
            e.preventDefault();
            alert('Le résumé ne doit pas dépasser 200 caractères');
            return false;
        }

        return true;
    });
</script>
{% endblock %}
