{# templates/workout/generated.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Votre Workout Personnalisé - Healfit</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* VARIABLES DE COULEUR */
        :root {
            --primary-green: #2E8B57;
            --light-green: #3CB371;
            --orange-primary: #FF6B35;
            --orange-light: #FF8C42;
            --blue-light: #E3F2FD;
            --yellow-light: #FFF3CD;
            --purple-light: #F3E5F5;
            --gray-light: #F8F9FA;
            --gray-medium: #E9ECEF;
            --gray-dark: #6C757D;
            --white: #FFFFFF;
            --black: #212529;
            --shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            --radius: 16px;
        }

        /* RESET ET BASE */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #e4e8f0 100%);
            color: var(--black);
            line-height: 1.6;
            padding: 20px;
            min-height: 100vh;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        /* CARD PRINCIPALE */
        .workout-card {
            background: var(--white);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            overflow: hidden;
            margin-bottom: 30px;
        }

        /* HEADER */
        .workout-header {
            background: linear-gradient(135deg, var(--primary-green), var(--light-green));
            color: var(--white);
            padding: 50px 40px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .workout-header::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.1) 1px, transparent 1px);
            background-size: 30px 30px;
            opacity: 0.2;
            animation: float 20s linear infinite;
        }

        @keyframes float {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .workout-title {
            font-size: 3.2rem;
            font-weight: 800;
            margin-bottom: 15px;
            position: relative;
            z-index: 2;
        }

        .workout-subtitle {
            font-size: 1.3rem;
            opacity: 0.9;
            margin-bottom: 30px;
            position: relative;
            z-index: 2;
        }

        .workout-date {
            background: rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(10px);
            padding: 12px 25px;
            border-radius: 50px;
            display: inline-block;
            font-weight: 600;
            position: relative;
            z-index: 2;
        }

        /* PROFIL RAPIDE */
        .profile-summary {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            padding: 30px 40px;
            background: var(--white);
        }

        .profile-card {
            background: var(--gray-light);
            padding: 20px;
            border-radius: 12px;
            text-align: center;
            border-left: 4px solid var(--orange-primary);
            transition: transform 0.3s ease;
        }

        .profile-card:hover {
            transform: translateY(-5px);
        }

        .profile-icon {
            font-size: 2rem;
            margin-bottom: 10px;
            color: var(--primary-green);
        }

        .profile-label {
            font-size: 0.9rem;
            color: var(--gray-dark);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 5px;
        }

        .profile-value {
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--black);
        }

        /* CONTENU WORKOUT */
        .workout-content {
            padding: 40px;
        }

        /* SECTIONS */
        .section {
            margin-bottom: 50px;
            animation: fadeInUp 0.6s ease-out;
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .section-header {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 3px solid;
        }

        .section-icon {
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, var(--primary-green), var(--light-green));
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            color: white;
        }

        .section-title {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--primary-green);
        }

        /* BOXES DE CONTENU */
        .content-box {
            background: var(--gray-light);
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 20px;
            border-left: 5px solid;
        }

        .motivation-box {
            background: linear-gradient(135deg, #E8F5E9, #C8E6C9);
            border-left-color: var(--primary-green);
        }

        .planning-box {
            background: linear-gradient(135deg, #E3F2FD, #BBDEFB);
            border-left-color: #2196F3;
        }

        .exercise-box {
            background: linear-gradient(135deg, #FFF3E0, #FFE0B2);
            border-left-color: var(--orange-primary);
        }

        .nutrition-box {
            background: linear-gradient(135deg, #F3E5F5, #E1BEE7);
            border-left-color: #9C27B0;
        }

        .recovery-box {
            background: linear-gradient(135deg, #E0F2F1, #B2DFDB);
            border-left-color: #009688;
        }

        .progress-box {
            background: linear-gradient(135deg, #FFF8E1, #FFECB3);
            border-left-color: #FFC107;
        }

        /* TABLEAU DE PLANNING */
        .planning-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            margin: 20px 0;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        }

        .planning-table th {
            background: linear-gradient(135deg, var(--primary-green), var(--light-green));
            color: white;
            padding: 15px;
            text-align: left;
            font-weight: 600;
        }

        .planning-table td {
            padding: 15px;
            background: var(--white);
            border-bottom: 1px solid var(--gray-medium);
        }

        .planning-table tr:last-child td {
            border-bottom: none;
        }

        .planning-table tr:hover td {
            background: var(--gray-light);
        }

        /* EXERCICES */
        .exercise-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }

        .exercise-card {
            background: var(--white);
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            border-top: 4px solid var(--orange-primary);
        }

        .exercise-name {
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--primary-green);
            margin-bottom: 10px;
        }

        .exercise-details {
            display: flex;
            gap: 15px;
            margin-top: 15px;
            flex-wrap: wrap;
        }

        .exercise-detail {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.9rem;
            color: var(--gray-dark);
        }

        .exercise-detail i {
            color: var(--orange-primary);
        }

        /* TIPS & CONSEILS */
        .tips-list {
            list-style: none;
            padding: 0;
        }

        .tip-item {
            display: flex;
            align-items: flex-start;
            gap: 15px;
            padding: 15px 0;
            border-bottom: 1px solid var(--gray-medium);
        }

        .tip-item:last-child {
            border-bottom: none;
        }

        .tip-icon {
            width: 30px;
            height: 30px;
            background: var(--primary-green);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            flex-shrink: 0;
        }

        /* PROGRESS BAR */
        .progress-container {
            margin: 30px 0;
        }

        .phase-progress {
            margin-bottom: 25px;
        }

        .phase-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 10px;
        }

        .phase-title {
            font-weight: 700;
            color: var(--primary-green);
        }

        .phase-bar {
            height: 10px;
            background: var(--gray-medium);
            border-radius: 5px;
            overflow: hidden;
            position: relative;
        }

        .phase-fill {
            height: 100%;
            border-radius: 5px;
            position: relative;
            transition: width 1s ease-in-out;
        }

        .phase-1 .phase-fill {
            width: 33%;
            background: linear-gradient(90deg, #4CAF50, #8BC34A);
        }

        .phase-2 .phase-fill {
            width: 66%;
            background: linear-gradient(90deg, #2196F3, #03A9F4);
        }

        .phase-3 .phase-fill {
            width: 100%;
            background: linear-gradient(90deg, #FF9800, #FFC107);
        }

        /* ACTIONS */
        .actions-container {
            display: flex;
            justify-content: center;
            gap: 20px;
            padding: 40px;
            background: var(--gray-light);
            border-top: 1px solid var(--gray-medium);
        }

        .action-btn {
            padding: 16px 35px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 12px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 12px;
            transition: all 0.3s ease;
            border: none;
            cursor: pointer;
            min-width: 200px;
            justify-content: center;
        }

        .btn-print {
            background: linear-gradient(135deg, var(--orange-primary), var(--orange-light));
            color: white;
            box-shadow: 0 6px 20px rgba(255, 107, 53, 0.3);
        }

        .btn-print:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(255, 107, 53, 0.4);
        }

        .btn-new {
            background: linear-gradient(135deg, var(--primary-green), var(--light-green));
            color: white;
            box-shadow: 0 6px 20px rgba(46, 139, 87, 0.3);
        }

        .btn-new:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(46, 139, 87, 0.4);
        }

        /* MOTIVATION */
        .motivation-section {
            text-align: center;
            padding: 40px;
            background: linear-gradient(135deg, rgba(46, 139, 87, 0.1), rgba(60, 179, 113, 0.1));
            border-radius: var(--radius);
            margin: 30px 0;
        }

        .quote {
            font-size: 1.4rem;
            font-style: italic;
            color: var(--primary-green);
            margin-bottom: 20px;
            position: relative;
            padding: 0 40px;
        }

        .quote::before, .quote::after {
            content: '"';
            font-size: 3rem;
            color: var(--orange-primary);
            position: absolute;
            opacity: 0.5;
        }

        .quote::before {
            top: -20px;
            left: 0;
        }

        .quote::after {
            bottom: -40px;
            right: 0;
        }

        /* FOOTER */
        .workout-footer {
            text-align: center;
            padding: 30px;
            color: var(--gray-dark);
            font-size: 0.95rem;
            background: var(--white);
            border-top: 1px solid var(--gray-medium);
        }

        .signature {
            margin-top: 20px;
            font-weight: 700;
            color: var(--primary-green);
        }

        /* MARQUEUR IMPORTANT */
        .highlight {
            background: linear-gradient(120deg, rgba(255, 107, 53, 0.1) 0%, rgba(255, 107, 53, 0) 100%);
            padding: 3px 8px;
            border-radius: 4px;
            border-left: 3px solid var(--orange-primary);
        }

        /* RESPONSIVE */
        @media (max-width: 768px) {
            .workout-header {
                padding: 30px 20px;
            }

            .workout-title {
                font-size: 2.2rem;
            }

            .profile-summary {
                grid-template-columns: repeat(2, 1fr);
                padding: 20px;
                gap: 15px;
            }

            .workout-content {
                padding: 20px;
            }

            .actions-container {
                flex-direction: column;
                padding: 30px 20px;
            }

            .action-btn {
                width: 100%;
            }

            .exercise-grid {
                grid-template-columns: 1fr;
            }

            .planning-table {
                display: block;
                overflow-x: auto;
            }
        }

        /* ANIMATIONS DE SECTION */
        .section:nth-child(1) { animation-delay: 0.1s; }
        .section:nth-child(2) { animation-delay: 0.2s; }
        .section:nth-child(3) { animation-delay: 0.3s; }
        .section:nth-child(4) { animation-delay: 0.4s; }
        .section:nth-child(5) { animation-delay: 0.5s; }
        .section:nth-child(6) { animation-delay: 0.6s; }

        /* PERSONNALISATION DU MARKDOWN */
        .markdown-content h2 {
            color: var(--primary-green);
            margin: 25px 0 15px;
            padding-bottom: 10px;
            border-bottom: 2px solid var(--orange-primary);
        }

        .markdown-content h3 {
            color: var(--orange-primary);
            margin: 20px 0 10px;
        }

        .markdown-content ul {
            padding-left: 25px;
            margin: 15px 0;
        }

        .markdown-content li {
            margin-bottom: 8px;
            position: relative;
        }

        .markdown-content li::before {
            content: '•';
            color: var(--orange-primary);
            font-weight: bold;
            position: absolute;
            left: -20px;
        }

        .markdown-content strong {
            color: var(--primary-green);
        }

        .markdown-content em {
            color: var(--gray-dark);
            font-style: italic;
        }

        /* BADGES */
        .badge {
            display: inline-block;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            margin: 0 5px 5px 0;
        }

        .badge-beginner {
            background: #E8F5E9;
            color: #2E8B57;
        }

        .badge-intermediate {
            background: #E3F2FD;
            color: #1976D2;
        }

        .badge-advanced {
            background: #FFF3E0;
            color: #FF6B35;
        }

        .badge-goal {
            background: #F3E5F5;
            color: #7B1FA2;
        }

        /* SCROLL ANIMATION */
        .section {
            opacity: 0;
            transform: translateY(30px);
            transition: all 0.6s ease-out;
        }

        .section.visible {
            opacity: 1;
            transform: translateY(0);
        }
    </style>
</head>
<body>
<div class="container">
    <!-- CARD PRINCIPALE -->
    <div class="workout-card">

        <!-- HEADER -->
        <div class="workout-header">
            <h1 class="workout-title">
                <i class="fas fa-dumbbell"></i> VOTRE WORKOUT SUR MESURE
            </h1>
            <p class="workout-subtitle">
                Programme généré spécialement pour vous
            </p>
            <div class="workout-date">
                <i class="fas fa-calendar-alt"></i> {{ workoutProfile.createdAt|date('d/m/Y à H:i') }}
            </div>
        </div>

        <!-- PROFIL RAPIDE -->
        <div class="profile-summary">
            <div class="profile-card">
                <div class="profile-icon">
                    <i class="fas fa-user"></i>
                </div>
                <div class="profile-label">Genre & Âge</div>
                <div class="profile-value">{{ workoutProfile.gender }}, {{ workoutProfile.age }} ans</div>
            </div>

            <div class="profile-card">
                <div class="profile-icon">
                    <i class="fas fa-chart-line"></i>
                </div>
                <div class="profile-label">Niveau</div>
                <div class="profile-value">
                    {% if workoutProfile.currentLevel == 'Débutant' %}
                        <span class="badge badge-beginner">Débutant</span>
                    {% elseif workoutProfile.currentLevel == 'Intermédiaire' %}
                        <span class="badge badge-intermediate">Intermédiaire</span>
                    {% else %}
                        <span class="badge badge-advanced">Avancé</span>
                    {% endif %}
                </div>
            </div>

            <div class="profile-card">
                <div class="profile-icon">
                    <i class="fas fa-bullseye"></i>
                </div>
                <div class="profile-label">Objectif</div>
                <div class="profile-value">
                    <span class="badge badge-goal">{{ workoutProfile.primaryGoal }}</span>
                </div>
            </div>

            <div class="profile-card">
                <div class="profile-icon">
                    <i class="fas fa-calendar-week"></i>
                </div>
                <div class="profile-label">Séances/Semaine</div>
                <div class="profile-value">{{ workoutProfile.sessionsPerWeek }}</div>
            </div>
        </div>

        <!-- CONTENU WORKOUT -->
        <div class="workout-content">

            <!-- SECTION MOTIVATION -->
            <div class="section" id="section-motivation">
                <div class="section-header">
                    <div class="section-icon">
                        <i class="fas fa-star"></i>
                    </div>
                    <h2 class="section-title">Motivation & Accueil</h2>
                </div>

                <div class="content-box motivation-box">
                    <div class="markdown-content">
                        {{ generatedWorkout|split('## 📅')[0]|raw|nl2br }}
                    </div>
                </div>
            </div>

            <!-- SECTION PLANNING -->
            <div class="section" id="section-planning">
                <div class="section-header">
                    <div class="section-icon">
                        <i class="fas fa-calendar-alt"></i>
                    </div>
                    <h2 class="section-title">Planning Hebdomadaire</h2>
                </div>

                <div class="content-box planning-box">
                    <div class="markdown-content">
                        {% set planningContent = generatedWorkout|split('## 📅')[1]|split('## 🏋️')[0] %}
                        {{ planningContent|raw|nl2br }}
                    </div>
                </div>
            </div>

            <!-- SECTION EXERCICES -->
            <div class="section" id="section-exercises">
                <div class="section-header">
                    <div class="section-icon">
                        <i class="fas fa-dumbbell"></i>
                    </div>
                    <h2 class="section-title">Exercices & Techniques</h2>
                </div>

                <div class="content-box exercise-box">
                    <div class="markdown-content">
                        {% set exerciseContent = generatedWorkout|split('## 🏋️')[1]|split('## 🔥')[0] %}
                        {{ exerciseContent|raw|nl2br }}
                    </div>
                </div>
            </div>

            <!-- SECTION NUTRITION -->
            <div class="section" id="section-nutrition">
                <div class="section-header">
                    <div class="section-icon">
                        <i class="fas fa-apple-alt"></i>
                    </div>
                    <h2 class="section-title">Nutrition & Hydratation</h2>
                </div>

                <div class="content-box nutrition-box">
                    <div class="markdown-content">
                        {% set nutritionContent = generatedWorkout|split('## 🥗')[1]|split('## 😴')[0] %}
                        {{ nutritionContent|raw|nl2br }}
                    </div>
                </div>
            </div>

            <!-- SECTION RÉCUPÉRATION -->
            <div class="section" id="section-recovery">
                <div class="section-header">
                    <div class="section-icon">
                        <i class="fas fa-bed"></i>
                    </div>
                    <h2 class="section-title">Récupération & Sommeil</h2>
                </div>

                <div class="content-box recovery-box">
                    <div class="markdown-content">
                        {% set recoveryContent = generatedWorkout|split('## 😴')[1]|split('## 📊')[0] %}
                        {{ recoveryContent|raw|nl2br }}
                    </div>
                </div>
            </div>

            <!-- SECTION PROGRESSION -->
            <div class="section" id="section-progress">
                <div class="section-header">
                    <div class="section-icon">
                        <i class="fas fa-chart-bar"></i>
                    </div>
                    <h2 class="section-title">Suivi & Progression</h2>
                </div>

                <div class="content-box progress-box">
                    <div class="markdown-content">
                        {% set progressContent = generatedWorkout|split('## 📊')[1]|split('## 🌈')[0] %}
                        {{ progressContent|raw|nl2br }}
                    </div>

                    <!-- BARRE DE PROGRESSION -->
                    <div class="progress-container">
                        <div class="phase-progress phase-1">
                            <div class="phase-header">
                                <span class="phase-title">Phase 1 : Acquisition (4 semaines)</span>
                                <span>33%</span>
                            </div>
                            <div class="phase-bar">
                                <div class="phase-fill"></div>
                            </div>
                        </div>

                        <div class="phase-progress phase-2">
                            <div class="phase-header">
                                <span class="phase-title">Phase 2 : Progression (4 semaines)</span>
                                <span>66%</span>
                            </div>
                            <div class="phase-bar">
                                <div class="phase-fill"></div>
                            </div>
                        </div>

                        <div class="phase-progress phase-3">
                            <div class="phase-header">
                                <span class="phase-title">Phase 3 : Optimisation (4 semaines)</span>
                                <span>100%</span>
                            </div>
                            <div class="phase-bar">
                                <div class="phase-fill"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECTION ENCOURAGEMENT -->
            <div class="motivation-section">
                <div class="quote">
                    {% set encouragementContent = generatedWorkout|split('## 🌈')[1] %}
                    {{ encouragementContent|replace({'## 🌈 **MOTIVATION & ACCOMPAGNEMENT**': ''})|raw|nl2br }}
                </div>
            </div>

        </div>

        <!-- ACTIONS -->
        <div class="actions-container">
            <button onclick="window.print()" class="action-btn btn-print">
                <i class="fas fa-print"></i> Imprimer mon Programme
            </button>
            <a href="{{ path('app_workout_personalized') }}" class="action-btn btn-new">
                <i class="fas fa-redo"></i> Créer un Nouveau Programme
            </a>
        </div>

        <!-- FOOTER -->
        <div class="workout-footer">
            <p>💚 <strong>Healfit</strong> - Votre succès commence ici !</p>
            <p>Ce programme vous est personnel. Partagez votre progression avec le hashtag <strong>#MonHealfit</strong></p>
            <p class="signature">L'équipe Healfit vous souhaite une excellente transformation ! 💪</p>
        </div>

    </div>
</div>

<script>
    // Animation au scroll
    document.addEventListener('DOMContentLoaded', function() {
        // Observer pour les animations de section
        const sections = document.querySelectorAll('.section');
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                }
            });
        }, { threshold: 0.1 });

        sections.forEach(section => {
            observer.observe(section);
        });

        // Animation des barres de progression
        const phaseBars = document.querySelectorAll('.phase-fill');
        phaseBars.forEach((bar, index) => {
            setTimeout(() => {
                bar.style.width = bar.parentElement.nextElementSibling.textContent.trim();
            }, 500 + (index * 300));
        });

        // Highlight des éléments importants
        const highlights = document.querySelectorAll('.markdown-content h2, .markdown-content h3');
        highlights.forEach((el, index) => {
            setTimeout(() => {
                el.classList.add('highlight');
            }, 1000 + (index * 100));
        });

        // Sauvegarde locale du programme
        const workoutData = {
            id: {{ workoutProfile.id }},
            date: '{{ workoutProfile.createdAt|date('Y-m-d') }}',
            goal: '{{ workoutProfile.primaryGoal }}',
            level: '{{ workoutProfile.currentLevel }}'
        };

        localStorage.setItem('healfit_last_workout', JSON.stringify(workoutData));

        // Message de succès
        console.log('🎉 Programme généré avec succès !');
        console.log('📊 Niveau: {{ workoutProfile.currentLevel }}');
        console.log('🎯 Objectif: {{ workoutProfile.primaryGoal }}');

        // Ajout d'icônes dynamiques
        document.querySelectorAll('.markdown-content').forEach(content => {
            // Remplacer les emojis par des icônes FontAwesome
            const replacements = {
                '🏆': '<i class="fas fa-trophy"></i>',
                '📅': '<i class="fas fa-calendar"></i>',
                '💪': '<i class="fas fa-dumbbell"></i>',
                '🥗': '<i class="fas fa-apple-alt"></i>',
                '😴': '<i class="fas fa-bed"></i>',
                '📊': '<i class="fas fa-chart-line"></i>',
                '🌟': '<i class="fas fa-star"></i>',
                '⚡': '<i class="fas fa-bolt"></i>',
                '🔥': '<i class="fas fa-fire"></i>',
                '🎯': '<i class="fas fa-bullseye"></i>',
                '💧': '<i class="fas fa-tint"></i>',
                '✅': '<i class="fas fa-check"></i>',
                '⚠️': '<i class="fas fa-exclamation-triangle"></i>',
                '💡': '<i class="fas fa-lightbulb"></i>'
            };

            Object.keys(replacements).forEach(emoji => {
                content.innerHTML = content.innerHTML.replace(new RegExp(emoji, 'g'), replacements[emoji]);
            });
        });
    });

    // Fonction pour partager sur les réseaux sociaux
    function shareWorkout() {
        const text = `Je viens de créer mon programme workout personnalisé avec Healfit ! 🏋️‍♂️ #MonHealfit #Fitness`;
        if (navigator.share) {
            navigator.share({
                title: 'Mon Workout Healfit',
                text: text,
                url: window.location.href
            });
        } else {
            alert('Partagez votre programme: ' + text);
        }
    }

    // Mode sombre (optionnel)
    function toggleDarkMode() {
        document.body.classList.toggle('dark-mode');
        localStorage.setItem('darkMode', document.body.classList.contains('dark-mode'));
    }

    // Charger le mode somme si préféré
    if (localStorage.getItem('darkMode') === 'true') {
        document.body.classList.add('dark-mode');
    }
</script>
</body>
</html>
