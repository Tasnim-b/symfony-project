{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Dashboard{% endblock %}

{% block main %}
    <div class="row">
        <!-- Total Users Widget -->
        <div class="col-md-3 mb-4">
            <div class="card bg-primary text-white h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase mb-1">Membres Inscrits</h6>
                            <h2 class="display-4 fw-bold mb-0">{{ stats.total_users }}</h2>
                        </div>
                        <i class="fas fa-users fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Active Users Widget -->
        <div class="col-md-3 mb-4">
            <div class="card bg-success text-white h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase mb-1">Membres Vérifiés</h6>
                            <h2 class="display-4 fw-bold mb-0">{{ stats.verified_users }}</h2>
                        </div>
                        <i class="fas fa-user-check fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Nutritionnistes Widget -->
        <div class="col-md-3 mb-4">
            <div class="card bg-info text-white h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase mb-1">Nutritionnistes</h6>
                            <h2 class="display-4 fw-bold mb-0">{{ stats.total_nutritionists }}</h2>
                        </div>
                        <i class="fas fa-user-md fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Articles Widget -->
        <div class="col-md-3 mb-4">
            <div class="card bg-warning text-dark h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase mb-1">Articles Publiés</h6>
                            <h2 class="display-4 fw-bold mb-0">{{ stats.total_articles }}</h2>
                        </div>
                        <i class="fas fa-newspaper fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
